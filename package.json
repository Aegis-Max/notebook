{
  "name": "cornell-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -s first \"npm:dev:web\" \"npm:dev:app\"",
    "dev:web": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:app": "wait-on tcp:127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .",
    "start": "npm run build && electron .",
    "build": "npm run typecheck && npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e:web": "playwright test --config=playwright.config.ts",
    "test:e2e:electron": "npm run build && playwright test --config=playwright.electron.config.ts",
    "test:e2e": "npm run test:e2e:web && npm run test:e2e:electron",
    "test": "npm run test:unit && npm run test:e2e",
    "package:mac": "npm run build && electron-builder --mac dmg dir --arm64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "build": {
    "appId": "com.neonshadow.cornell-notebook",
    "productName": "康奈尔笔记",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "Cornell-Notebook-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "康奈尔笔记 ${version}",
      "backgroundColor": "#edf3ef",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
