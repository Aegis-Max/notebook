{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts",
    "src/domain/**/*.ts",
    "src/types/desktop.ts"
  ],
  "exclude": ["tests", "release", "dist"]
}
